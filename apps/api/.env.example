# Copy to .env and supply the connection string for the database you intend to use.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/DATABASE?schema=public"
PORT=4000
# Owner access is disabled until all three values are set. Generate the last two
# with pnpm --filter @carbignite/api admin:credentials. Never commit real secrets.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
