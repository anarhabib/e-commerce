# Copy to .env. Runtime uses the pooled Neon URL; Prisma migrations use the direct URL.
# For local PostgreSQL, both may use the same connection string.
# Neon CLI exports DATABASE_URL_UNPOOLED; copy that value to DIRECT_URL below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
PORT=4000
# Owner access is disabled until all three values are set. Generate the last two
# with pnpm --filter @carbignite/api admin:credentials. Never commit real secrets.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""

# Run pnpm neon:sync-env after neon deploy to copy these from root .env.local.
# Keep this entire group empty to retain database-only image storage locally.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
MEDIA_BUCKET="assets"
NEON_REALTIME_URL=""
NEON_REALTIME_SECRET=""
# Shared only between the Next server and the Neon API Function.
API_ORIGIN_SECRET=""
# Set to the deployed frontend origin before deploying browser Realtime config.
APP_ORIGIN=""
