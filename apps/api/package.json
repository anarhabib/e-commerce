{
  "name": "@carbignite/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "seed:demo": "tsx --env-file=.env prisma/seed.ts",
    "test": "node --import tsx --test tests/product-schema.test.ts",
    "test:integration": "node --env-file=.env --import tsx --test tests/products.integration.test.ts",
    "start": "node --env-file=.env dist/src/server.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
