// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  PADDLES
  CONSOLE
  TRIM
}

enum CarbonPattern {
  Woven
  Forged
}

enum CarbonFinish {
  Gloss
  Satin
  Matte
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  sku         String          @unique
  category    ProductCategory
  priceCents  Int
  imageUrl    String?
  imageUrls   String[]        @default([])
  stock       Int             @default(0)
  active      Boolean         @default(true)
  currency    String          @default("USD")
  photoIndex  Int?
  isSample    Boolean         @default(false)
  patterns    CarbonPattern[] @default([Woven, Forged])
  finishes    CarbonFinish[]  @default([Gloss, Satin, Matte])

  make        String?
  model       String?
  yearFrom    Int?
  yearTo      Int?


  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

enum RequestStatus {
  requested
  in_review
  quoted
  in_production
  shipped
  cancelled
}

// Immutable customer/item snapshots preserve the request even if the catalog changes.
model OrderRequest {
  id         String        @id
  customer   Json
  items      Json
  totalCents Int
  status     RequestStatus @default(requested)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  contentType String
  data        Bytes
  createdAt   DateTime @default(now())
}
