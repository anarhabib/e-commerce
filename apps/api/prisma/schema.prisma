generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductCategory {
  PADDLES
  CONSOLE
  TRIM
}

enum CarbonPattern {
  Woven
  Forged
}

enum CarbonFinish {
  Gloss
  Satin
  Matte
}

model Product {
  id          String          @id @default(cuid())
  name        String
  slug        String          @unique
  description String
  sku         String          @unique
  category    ProductCategory
  priceCents  Int
  imageUrl    String?
  stock       Int             @default(0)
  currency    String          @default("USD")
  photoIndex  Int?
  isSample    Boolean         @default(false)
  patterns    CarbonPattern[] @default([Woven, Forged])
  finishes    CarbonFinish[]  @default([Gloss, Satin, Matte])

  make        String?
  model       String?
  yearFrom    Int?
  yearTo      Int?


  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}