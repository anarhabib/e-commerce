# Server-only URL used by Next.js for backend requests. Never expose this as NEXT_PUBLIC_API_URL.
API_URL=http://localhost:4000
# Server-only. Required when API_URL points at the Neon API Function.
API_ORIGIN_SECRET=""
# Customer accounts use a same-origin Next proxy; owner authentication is separate.
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
# Optional public frontend origin for other reverse proxies/custom domains.
# Render's default URL is detected from its server-provided RENDER_EXTERNAL_URL.
APP_ORIGIN=""
